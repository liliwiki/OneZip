// 发现新版本时的提示：立即更新 / 跳过这个版本 / 以后再说，以及"以后不再自动提示"。
import { Button, CheckBox, Palette, ProgressIndicator, TextEdit, VerticalBox } from "std-widgets.slint";
import { ThemedWindow } from "theme.slint";

export component UpdateDialog inherits ThemedWindow {
    title: "OneZip 更新";
    preferred-width: 560px;
    preferred-height: 420px;
    min-width: 420px;
    min-height: 300px;

    in property <string> heading;
    in property <string> notes;
    // 下载中 / 等任务完成 / 出错时的说明；空表示还没开始。
    in property <string> status;
    in property <bool> failed;
    // 0..1，小于 0 表示进度未知。
    in property <float> progress: -1;
    // 正在下载或在等任务完成：只留"取消"。
    in property <bool> busy;
    in-out property <bool> never-ask;
    // 手动检查时不显示"以后不再自动提示"。
    in property <bool> automatic: true;

    callback update-now();
    callback skip-version();
    callback later();

    VerticalBox {
        Text {
            text: root.heading;
            font-size: 16px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: "更新内容：";
            opacity: 0.7;
        }
        TextEdit {
            text: root.notes;
            read-only: true;
            vertical-stretch: 1;
        }
        if root.status != "": VerticalLayout {
            spacing: 6px;
            if root.busy: ProgressIndicator {
                progress: max(root.progress, 0);
                indeterminate: root.progress < 0;
            }
            Text {
                text: root.status;
                wrap: word-wrap;
                color: root.failed ? #e5534b : Palette.foreground;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            if root.automatic && !root.busy: CheckBox {
                text: "以后不再自动提示";
                checked <=> root.never-ask;
            }
            Rectangle { horizontal-stretch: 1; }
            if !root.busy: Button {
                text: "立即更新";
                primary: true;
                clicked => { root.update-now(); }
            }
            if !root.busy: Button {
                text: "跳过这个版本";
                clicked => { root.skip-version(); }
            }
            Button {
                text: root.busy ? "取消" : "以后再说";
                clicked => { root.later(); }
            }
        }
    }
}
