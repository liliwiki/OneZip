// 需要密码时的密码框。
import { Button, LineEdit, VerticalBox } from "std-widgets.slint";
import { ThemedWindow } from "theme.slint";

export component PasswordDialog inherits ThemedWindow {
    title: "需要密码";
    preferred-width: 420px;

    in property <string> archive;
    in property <bool> retry;
    in-out property <string> password;

    callback accept();
    callback reject();

    VerticalBox {
        Text {
            text: (root.retry ? "密码不对，请重新输入。\n" : "") + root.archive + " 已加密，请输入密码：";
            wrap: word-wrap;
        }
        pw := LineEdit {
            input-type: InputType.password;
            text <=> root.password;
            accepted => { root.accept(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "取消";
                clicked => { root.reject(); }
            }
            Button {
                text: "确定";
                primary: true;
                clicked => { root.accept(); }
            }
        }
    }
    init => { pw.focus(); }
}
