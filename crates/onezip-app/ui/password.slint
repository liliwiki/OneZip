// 需要密码时的密码框。
import { Button, CheckBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { ThemedWindow } from "theme.slint";

export component PasswordDialog inherits ThemedWindow {
    title: @tr("需要密码");
    preferred-width: 420px;

    in property <string> archive;
    in property <bool> retry;
    in-out property <string> password;
    in-out property <bool> remember;

    callback accept();
    callback reject();

    VerticalBox {
        Text {
            text: (root.retry ? @tr("密码不对，请重新输入。\n") : "") + @tr("{} 已加密，请输入密码：", root.archive);
            wrap: word-wrap;
        }
        pw := LineEdit {
            input-type: InputType.password;
            text <=> root.password;
            accepted => { root.accept(); }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: @tr("记住这个密码");
                checked <=> root.remember;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("取消");
                clicked => { root.reject(); }
            }
            Button {
                text: @tr("确定");
                primary: true;
                clicked => { root.accept(); }
            }
        }
    }
    init => { pw.focus(); }
}
