import {
    Button, CheckBox, ComboBox, LineEdit, ListView, ProgressIndicator, Slider, TextEdit,
    VerticalBox, HorizontalBox, GroupBox, Palette,
} from "std-widgets.slint";

export struct TaskRow {
    id: int,
    title: string,
    detail: string,
    // 0..1；小于 0 表示进度未知。
    progress: float,
    state: string,
    can-pause: bool,
    can-resume: bool,
    can-cancel: bool,
    can-remove: bool,
    can-open: bool,
    // “打开”按钮的文字：解压/压缩是“打开”，校验值是“查看”。
    open-label: string,
    needs-password: bool,
}

component TaskItem inherits Rectangle {
    in property <TaskRow> task;
    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback remove(int);
    callback open(int);
    callback password(int);

    height: 76px;
    border-radius: 6px;
    background: Palette.alternate-background;

    HorizontalBox {
        padding: 10px;
        spacing: 8px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: task.title;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: task.state;
                    opacity: 0.7;
                }
            }
            ProgressIndicator {
                progress: max(task.progress, 0);
                indeterminate: task.progress < 0;
            }
            Text {
                text: task.detail;
                font-size: 11px;
                opacity: 0.7;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                if task.needs-password: Button {
                    text: "输入密码";
                    primary: true;
                    clicked => { root.password(task.id); }
                }
                if task.can-pause: Button {
                    text: "暂停";
                    clicked => { root.pause(task.id); }
                }
                if task.can-resume: Button {
                    text: "继续";
                    primary: true;
                    clicked => { root.resume(task.id); }
                }
                if task.can-cancel: Button {
                    text: "取消";
                    clicked => { root.cancel(task.id); }
                }
                if task.can-open: Button {
                    text: task.open-label;
                    clicked => { root.open(task.id); }
                }
                if task.can-remove: Button {
                    text: "移除";
                    clicked => { root.remove(task.id); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "OneZip";
    icon: @image-url("../../../assets/onezip-256.png");
    preferred-width: 760px;
    preferred-height: 520px;
    min-width: 520px;
    min-height: 360px;

    in property <[TaskRow]> tasks;
    in property <string> status;
    in-out property <string> url;
    in-out property <bool> reclaim: false;
    in-out property <bool> nested: true;

    callback compress-files();
    callback compress-folder();
    callback extract-files();
    callback extract-url(string);
    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback remove(int);
    callback open(int);
    callback password(int);
    callback clear-finished();
    callback register-menu();

    VerticalBox {
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "解压…";
                primary: true;
                clicked => { root.extract-files(); }
            }
            Button {
                text: "压缩文件…";
                clicked => { root.compress-files(); }
            }
            Button {
                text: "压缩文件夹…";
                clicked => { root.compress-folder(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "右键菜单…";
                clicked => { root.register-menu(); }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            CheckBox {
                text: "解压时释放原压缩包空间（边解边删）";
                checked <=> root.reclaim;
            }
            CheckBox {
                text: "自动解开嵌套压缩包";
                checked <=> root.nested;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            url-edit := LineEdit {
                placeholder-text: "粘贴 http(s) 链接：边下载边解压，用过的下载数据立即释放";
                text <=> root.url;
                accepted(t) => { root.extract-url(t); }
            }
            Button {
                text: "下载并解压";
                enabled: root.url != "";
                clicked => { root.extract-url(root.url); }
            }
        }
        HorizontalLayout {
            Text {
                text: root.tasks.length == 0
                    ? "还没有任务。在资源管理器里右键压缩包或文件，或者使用上面的按钮。"
                    : "任务";
                opacity: 0.7;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.tasks.length > 0: Button {
                text: "清除已完成";
                clicked => { root.clear-finished(); }
            }
        }
        ListView {
            vertical-stretch: 1;
            for task in root.tasks: VerticalLayout {
                padding-bottom: 6px;
                TaskItem {
                    task: task;
                    pause(id) => { root.pause(id); }
                    resume(id) => { root.resume(id); }
                    cancel(id) => { root.cancel(id); }
                    remove(id) => { root.remove(id); }
                    open(id) => { root.open(id); }
                    password(id) => { root.password(id); }
                }
            }
        }
        Text {
            text: root.status;
            font-size: 11px;
            opacity: 0.6;
        }
    }
}

export component CompressDialog inherits Window {
    title: "添加到压缩包";
    icon: @image-url("../../../assets/onezip-256.png");
    preferred-width: 520px;

    in property <string> inputs-label;
    in property <[string]> formats;
    in-out property <string> output;
    in-out property <int> format-index: 0;
    in-out property <float> level: 5;
    in-out property <string> password;
    in-out property <bool> solid: true;
    in property <bool> password-allowed: true;

    callback format-changed(int);
    callback browse();
    callback accept();
    callback reject();

    VerticalBox {
        Text {
            text: root.inputs-label;
            overflow: elide;
            opacity: 0.8;
        }
        GroupBox {
            title: "压缩包";
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.output;
                }
                Button {
                    text: "浏览…";
                    clicked => { root.browse(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { text: "格式"; }
                ComboBox {
                    model: root.formats;
                    current-index <=> root.format-index;
                    selected => { root.format-changed(self.current-index); }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "压缩级别：" + (root.level < 0.5 ? "仅存储" : root.level < 3.5 ? "快速" : root.level < 6.5 ? "标准" : "最强") + "（" + round(root.level) + "）";
                }
                Slider {
                    minimum: 0;
                    maximum: 9;
                    value <=> root.level;
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.password-allowed ? "密码（留空不加密）" : "这种格式不支持密码";
            }
            LineEdit {
                input-type: InputType.password;
                enabled: root.password-allowed;
                text <=> root.password;
            }
        }
        if root.format-index == 0: CheckBox {
            text: "固实压缩（压缩率更高）";
            checked <=> root.solid;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "取消";
                clicked => { root.reject(); }
            }
            Button {
                text: "开始压缩";
                primary: true;
                enabled: root.output != "";
                clicked => { root.accept(); }
            }
        }
    }
}

export component PasswordDialog inherits Window {
    title: "需要密码";
    icon: @image-url("../../../assets/onezip-256.png");
    preferred-width: 420px;

    in property <string> archive;
    in property <bool> retry;
    in-out property <string> password;

    callback accept();
    callback reject();

    VerticalBox {
        Text {
            text: (root.retry ? "密码不对，请重新输入。\n" : "") + root.archive + " 已加密，请输入密码：";
            wrap: word-wrap;
        }
        pw := LineEdit {
            input-type: InputType.password;
            text <=> root.password;
            accepted => { root.accept(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "取消";
                clicked => { root.reject(); }
            }
            Button {
                text: "确定";
                primary: true;
                clicked => { root.accept(); }
            }
        }
    }
    init => { pw.focus(); }
}

/// 校验值结果（右键菜单 "CRC SHA"）。
export component HashDialog inherits Window {
    title: "校验值";
    icon: @image-url("../../../assets/onezip-256.png");
    preferred-width: 720px;
    preferred-height: 420px;
    min-width: 420px;
    min-height: 220px;

    in property <string> text;
    in-out property <string> copied: "";

    callback copy();
    callback dismiss();

    VerticalBox {
        TextEdit {
            text: root.text;
            read-only: true;
            wrap: no-wrap;
            font-family: "Consolas";
            font-size: 13px;
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.copied;
                opacity: 0.7;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "复制";
                clicked => { root.copy(); }
            }
            Button {
                text: "关闭";
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}

/// 右键菜单发起的单个任务的进度窗口（像 7-Zip / NanaZip 那样），做完自动关闭。
export component ProgressDialog inherits Window {
    title: root.caption;
    icon: @image-url("../../../assets/onezip-256.png");
    preferred-width: 520px;
    min-width: 420px;

    // 窗口标题，如 “37% 解压 资料.zip”。
    in property <string> caption;
    in property <string> heading;
    // 0..1；小于 0 表示进度未知。
    in property <float> progress;
    in property <string> elapsed;
    in property <string> remaining;
    in property <string> speed;
    in property <string> processed;
    // 额外一行（如“原压缩包剩余 1.2 GB”）。
    in property <string> extra;
    // 结束时的结果或错误；非空时显示在进度条下面。
    in property <string> message;
    in property <bool> failed;
    // 已结束（失败、测试完成）：只留“关闭”。
    in property <bool> finished;
    in property <bool> can-pause;
    in property <bool> can-resume;
    in property <bool> can-cancel;

    callback pause();
    callback resume();
    callback cancel();
    callback show-tasks();
    callback dismiss();

    VerticalBox {
        Text {
            text: root.heading;
            font-weight: 600;
            overflow: elide;
        }
        GridLayout {
            spacing-horizontal: 12px;
            spacing-vertical: 4px;
            Row {
                Text { text: "已用时间："; opacity: 0.7; }
                Text { text: root.elapsed; }
                Text { text: "剩余时间："; opacity: 0.7; }
                Text { text: root.remaining; }
            }
            Row {
                Text { text: "速度："; opacity: 0.7; }
                Text { text: root.speed; }
                Text { text: "已处理："; opacity: 0.7; }
                Text { text: root.processed; }
            }
        }
        ProgressIndicator {
            progress: max(root.progress, 0);
            indeterminate: root.progress < 0 && !root.finished;
        }
        if root.extra != "": Text {
            text: root.extra;
            font-size: 11px;
            opacity: 0.7;
        }
        if root.message != "": Text {
            text: root.message;
            wrap: word-wrap;
            color: root.failed ? #e5534b : Palette.foreground;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "任务列表";
                clicked => { root.show-tasks(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.can-pause: Button {
                text: "暂停";
                clicked => { root.pause(); }
            }
            if root.can-resume: Button {
                text: "继续";
                primary: true;
                clicked => { root.resume(); }
            }
            if root.can-cancel: Button {
                text: "取消";
                clicked => { root.cancel(); }
            }
            if root.finished: Button {
                text: "关闭";
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}
