// 主窗口：按钮、勾选项、链接框、任务列表。
import { Button, CheckBox, LineEdit, ListView, ProgressIndicator, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { ThemedWindow } from "theme.slint";

export struct TaskRow {
    id: int,
    title: string,
    detail: string,
    // 0..1；小于 0 表示进度未知。
    progress: float,
    state: string,
    can-pause: bool,
    can-resume: bool,
    can-cancel: bool,
    can-remove: bool,
    can-open: bool,
    // “打开”按钮的文字：解压/压缩是“打开”，校验值是“查看”。
    open-label: string,
    needs-password: bool,
}

component TaskItem inherits Rectangle {
    in property <TaskRow> task;
    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback remove(int);
    callback open(int);
    callback password(int);

    height: 76px;
    border-radius: 6px;
    background: Palette.alternate-background;

    HorizontalBox {
        padding: 10px;
        spacing: 8px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: task.title;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: task.state;
                    opacity: 0.7;
                }
            }
            ProgressIndicator {
                progress: max(task.progress, 0);
                indeterminate: task.progress < 0;
            }
            Text {
                text: task.detail;
                font-size: 11px;
                opacity: 0.7;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                if task.needs-password: Button {
                    text: @tr("输入密码");
                    primary: true;
                    clicked => { root.password(task.id); }
                }
                if task.can-pause: Button {
                    text: @tr("暂停");
                    clicked => { root.pause(task.id); }
                }
                if task.can-resume: Button {
                    text: @tr("继续");
                    primary: true;
                    clicked => { root.resume(task.id); }
                }
                if task.can-cancel: Button {
                    text: @tr("取消");
                    clicked => { root.cancel(task.id); }
                }
                if task.can-open: Button {
                    text: task.open-label;
                    clicked => { root.open(task.id); }
                }
                if task.can-remove: Button {
                    text: @tr("移除");
                    clicked => { root.remove(task.id); }
                }
            }
        }
    }
}

export component MainWindow inherits ThemedWindow {
    title: "OneZip";
    preferred-width: 760px;
    preferred-height: 520px;
    min-width: 520px;
    min-height: 360px;

    in property <[TaskRow]> tasks;
    in property <string> status;
    in-out property <string> url;
    in-out property <bool> reclaim: false;

    callback compress-files();
    callback compress-folder();
    callback extract-files();
    callback open-archive();
    callback extract-url(string);
    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback remove(int);
    callback open(int);
    callback password(int);
    callback clear-finished();
    callback open-settings();

    VerticalBox {
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: @tr("解压…");
                primary: true;
                clicked => { root.extract-files(); }
            }
            Button {
                text: @tr("打开压缩包…");
                clicked => { root.open-archive(); }
            }
            Button {
                text: @tr("压缩文件…");
                clicked => { root.compress-files(); }
            }
            Button {
                text: @tr("压缩文件夹…");
                clicked => { root.compress-folder(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("设置");
                clicked => { root.open-settings(); }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            CheckBox {
                text: @tr("解压时释放原压缩包空间（边解边删）");
                checked <=> root.reclaim;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            url-edit := LineEdit {
                placeholder-text: @tr("粘贴 http(s) 链接：边下载边解压，用过的下载数据立即释放");
                text <=> root.url;
                accepted(t) => { root.extract-url(t); }
            }
            Button {
                text: @tr("下载并解压");
                enabled: root.url != "";
                clicked => { root.extract-url(root.url); }
            }
        }
        HorizontalLayout {
            Text {
                text: root.tasks.length == 0
                    ? @tr("还没有任务。在资源管理器里右键压缩包或文件，或者使用上面的按钮。")
                    : @tr("任务");
                opacity: 0.7;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.tasks.length > 0: Button {
                text: @tr("清除已完成");
                clicked => { root.clear-finished(); }
            }
        }
        ListView {
            vertical-stretch: 1;
            for task in root.tasks: VerticalLayout {
                padding-bottom: 6px;
                TaskItem {
                    task: task;
                    pause(id) => { root.pause(id); }
                    resume(id) => { root.resume(id); }
                    cancel(id) => { root.cancel(id); }
                    remove(id) => { root.remove(id); }
                    open(id) => { root.open(id); }
                    password(id) => { root.password(id); }
                }
            }
        }
        Text {
            text: root.status;
            font-size: 11px;
            opacity: 0.6;
        }
    }
}
