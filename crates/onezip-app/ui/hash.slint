import { Button, TextEdit, VerticalBox } from "std-widgets.slint";
import { ThemedWindow } from "theme.slint";

/// 校验值结果（右键菜单 "CRC SHA"）。
export component HashDialog inherits ThemedWindow {
    title: @tr("校验值");
    preferred-width: 720px;
    preferred-height: 420px;
    min-width: 420px;
    min-height: 220px;

    in property <string> text;
    in-out property <string> copied: "";

    callback copy();
    callback dismiss();

    VerticalBox {
        TextEdit {
            text: root.text;
            read-only: true;
            wrap: no-wrap;
            font-family: "Consolas";
            font-size: 13px;
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.copied;
                opacity: 0.7;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("复制");
                clicked => { root.copy(); }
            }
            Button {
                text: @tr("关闭");
                primary: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}
