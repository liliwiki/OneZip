import { Button, CheckBox, LineEdit, Palette, ProgressIndicator, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SetupWindow inherits Window {
    in property <string> version;
    // 用户选的位置（可以改）；target 是实际会装进去的文件夹，problem 不为空时不能装。
    in-out property <string> location;
    in property <string> target;
    in property <string> problem;
    in property <bool> upgrade;
    in property <bool> win11;
    // ready / installing / done / failed
    in-out property <string> stage: "ready";
    in property <string> error;
    // 安装中的当前步骤；updating：由 OneZip 的"立即更新"启动，不问问题，装完自动重新打开。
    in property <string> status;
    in property <bool> updating;
    in-out property <bool> launch: true;
    callback install();
    callback browse();
    callback location-edited(string);
    callback finish();
    callback quit();

    title: (updating ? "更新 OneZip " : "安装 OneZip ") + version;
    icon: @image-url("../../../assets/onezip-256.png");
    width: 520px;
    height: 380px;

    VerticalBox {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 16px;
            Image {
                source: @image-url("../../../assets/onezip-256.png");
                width: 64px;
                height: 64px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "OneZip " + version;
                    font-size: 20px;
                    font-weight: 600;
                }
                Text {
                    text: "压缩、解压、边解压边释放空间、边下载边解压";
                    opacity: 0.7;
                }
            }
        }

        if stage == "ready": VerticalLayout {
            spacing: 6px;
            Text {
                text: upgrade ? "更新已安装的 OneZip。安装位置：" : "安装位置（只给当前用户安装）：";
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.location;
                    horizontal-stretch: 1;
                    edited(t) => { root.location-edited(t); }
                }
                Button {
                    text: "浏览…";
                    clicked => { root.browse(); }
                }
            }
            Text {
                text: problem != "" ? problem : "将装到：" + target;
                color: problem != "" ? #e05050 : Palette.foreground;
                wrap: word-wrap;
                opacity: problem != "" ? 1 : 0.7;
                visible: problem != "" || target != location;
            }
            Text {
                text: "装到需要管理员权限的文件夹（如 C:\\Program Files）时会弹一次管理员确认。";
                wrap: word-wrap;
                opacity: 0.7;
            }
            Text {
                visible: win11;
                text: "如果是第一次安装，会弹出一次管理员确认，用来信任右键菜单的签名证书。";
                wrap: word-wrap;
                opacity: 0.7;
            }
        }
        if stage == "installing": VerticalLayout {
            spacing: 8px;
            Text { text: status != "" ? status : (updating ? "正在更新…" : "正在安装…"); }
            ProgressIndicator { indeterminate: true; }
        }
        if stage == "done": VerticalLayout {
            spacing: 8px;
            Text {
                text: "安装完成。右键文件或文件夹，在菜单里的“OneZip”中使用。";
                wrap: word-wrap;
            }
            Text {
                visible: win11;
                text: "如果右键菜单里暂时没有 OneZip，重启一次资源管理器或注销后即可。";
                wrap: word-wrap;
                opacity: 0.7;
            }
            CheckBox {
                text: "现在打开 OneZip";
                checked <=> root.launch;
            }
        }
        if stage == "failed": VerticalLayout {
            spacing: 6px;
            Text {
                text: "安装没有完成：";
                font-weight: 600;
            }
            Text {
                text: error;
                wrap: word-wrap;
                opacity: 0.8;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if stage == "ready": Button {
                text: "安装";
                primary: true;
                enabled: problem == "";
                clicked => { root.install(); }
            }
            if stage == "ready" || stage == "failed": Button {
                text: stage == "failed" ? "关闭" : "取消";
                clicked => { root.quit(); }
            }
            if stage == "done": Button {
                text: "完成";
                primary: true;
                clicked => { root.finish(); }
            }
        }
    }
}

// 卸载：先确认，可选同时删除设置。
export component UninstallWindow inherits Window {
    in property <string> version;
    in property <string> location;
    // confirm / working / done / failed
    in-out property <string> stage: "confirm";
    in property <string> status;
    in property <string> error;
    in-out property <bool> delete-settings: false;
    callback uninstall();
    callback quit();

    title: "卸载 OneZip";
    icon: @image-url("../../../assets/onezip-256.png");
    width: 480px;
    height: 300px;

    VerticalBox {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 16px;
            Image {
                source: @image-url("../../../assets/onezip-256.png");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "卸载 OneZip " + version;
                    font-size: 18px;
                    font-weight: 600;
                }
                Text {
                    text: location;
                    opacity: 0.7;
                    overflow: elide;
                }
            }
        }
        if stage == "confirm": VerticalLayout {
            spacing: 8px;
            Text {
                text: "会移除 OneZip 的程序、右键菜单和开始菜单快捷方式。解压、压缩出来的文件不受影响；正在运行的 OneZip 会被关闭。";
                wrap: word-wrap;
            }
            CheckBox {
                text: "同时删除 OneZip 的设置和出错记录";
                checked <=> root.delete-settings;
            }
        }
        if stage == "working": VerticalLayout {
            spacing: 8px;
            Text { text: status != "" ? status : "正在卸载…"; }
            ProgressIndicator { indeterminate: true; }
        }
        if stage == "done": Text {
            text: "OneZip 已卸载。";
            wrap: word-wrap;
        }
        if stage == "failed": VerticalLayout {
            spacing: 6px;
            Text {
                text: "卸载没有全部完成：";
                font-weight: 600;
            }
            Text {
                text: error;
                wrap: word-wrap;
                opacity: 0.8;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if stage == "confirm": Button {
                text: "卸载";
                primary: true;
                clicked => { root.uninstall(); }
            }
            if stage != "working": Button {
                text: stage == "confirm" ? "取消" : "关闭";
                primary: stage == "done";
                clicked => { root.quit(); }
            }
        }
    }
}
