import { Button, CheckBox, ProgressIndicator, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SetupWindow inherits Window {
    in property <string> version;
    in property <string> location;
    in property <bool> upgrade;
    in property <bool> win11;
    // ready / installing / done / failed
    in-out property <string> stage: "ready";
    in property <string> error;
    in-out property <bool> launch: true;
    callback install();
    callback finish();
    callback quit();

    title: "安装 OneZip " + version;
    icon: @image-url("../../../assets/onezip-256.png");
    width: 520px;
    height: 330px;

    VerticalBox {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 16px;
            Image {
                source: @image-url("../../../assets/onezip-256.png");
                width: 64px;
                height: 64px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "OneZip " + version;
                    font-size: 20px;
                    font-weight: 600;
                }
                Text {
                    text: "压缩、解压、边解压边释放空间、边下载边解压";
                    opacity: 0.7;
                }
            }
        }

        if stage == "ready": VerticalLayout {
            spacing: 6px;
            Text {
                text: (upgrade ? "将更新已安装的 OneZip，位置：" : "安装位置（只给当前用户安装）：");
            }
            Text {
                text: location;
                wrap: word-wrap;
                opacity: 0.8;
            }
            Text {
                visible: win11;
                text: "如果是第一次安装，会弹出一次管理员确认，用来信任右键菜单的签名证书。";
                wrap: word-wrap;
                opacity: 0.7;
            }
        }
        if stage == "installing": VerticalLayout {
            spacing: 8px;
            Text { text: "正在安装…"; }
            ProgressIndicator { indeterminate: true; }
        }
        if stage == "done": VerticalLayout {
            spacing: 8px;
            Text {
                text: "安装完成。右键文件或文件夹，在菜单里的“OneZip”中使用。";
                wrap: word-wrap;
            }
            Text {
                visible: win11;
                text: "如果右键菜单里暂时没有 OneZip，重启一次资源管理器或注销后即可。";
                wrap: word-wrap;
                opacity: 0.7;
            }
            CheckBox {
                text: "现在打开 OneZip";
                checked <=> root.launch;
            }
        }
        if stage == "failed": VerticalLayout {
            spacing: 6px;
            Text {
                text: "安装没有完成：";
                font-weight: 600;
            }
            Text {
                text: error;
                wrap: word-wrap;
                opacity: 0.8;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if stage == "ready": Button {
                text: "安装";
                primary: true;
                clicked => { root.install(); }
            }
            if stage == "ready" || stage == "failed": Button {
                text: stage == "failed" ? "关闭" : "取消";
                clicked => { root.quit(); }
            }
            if stage == "done": Button {
                text: "完成";
                primary: true;
                clicked => { root.finish(); }
            }
        }
    }
}
