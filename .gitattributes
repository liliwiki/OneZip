# Auto detect text files and perform LF normalization
* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.slint text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
Cargo.lock text eol=lf

*.ico binary
*.png binary
*.msix binary
*.exe binary
*.dll binary
*.7z binary
*.zip binary
*.xz binary
*.lz binary
*.lzma binary
